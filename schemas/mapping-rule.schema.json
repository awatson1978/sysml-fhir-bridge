{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodeonsysml.example/schemas/mapping-rule.schema.json",
  "title": "MappingRule",
  "description": "Human-approved crosswalk rule. Empty targetResourceTypes means: no semantically legitimate direct FHIR mapping.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sourceKind": { "type": "string", "minLength": 1 },
    "relationship": {
      "enum": [
        "realizes",
        "satisfies",
        "constrains",
        "emits",
        "consumes",
        "operationalizes",
        "verifiedBy",
        "evidenceFor",
        "documentedBy",
        "derivedFrom"
      ]
    },
    "targetResourceTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cardinality": { "type": "string" },
    "semanticConfidence": { "enum": ["exact", "strong", "contextual"] },
    "notes": { "type": "string" }
  },
  "required": [
    "id",
    "version",
    "description",
    "sourceKind",
    "relationship",
    "targetResourceTypes",
    "cardinality",
    "semanticConfidence"
  ],
  "additionalProperties": false
}
